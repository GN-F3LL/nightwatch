{
    "name": "signal/laravel-agent",
    "description": "Reports server resources, stack versions, exceptions, logs, requests and jobs of a Laravel app to a self-hosted Signal dashboard.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Signal\\Agent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Signal\\Agent\\SignalAgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
